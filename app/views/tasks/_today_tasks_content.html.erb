<% tasks.each do |task| %>
    <tr>
      <td class="collapsing">
        <div class="ui fitted slider checkbox">
          <input type="checkbox"> <label></label>
        </div>
      </td>
      <td><%= task.title %></td>
      <td><%= task_note(task) %></td>
      <td>Category</td>
      <td><%= task_reminder(task) %></td>
      <td class="<%= task_priority_color(task) %>"><%= task_priority(task) %></td>
      <td class="<%= task.status == 1 ? 'positive' : 'negative' %>"><%= task_status(task) %></td>
      <td>
        <i class="edit icon" style="color: #1A78C2"></i>
        <i class="eye icon" style="color: green"></i>
        <i class="trash alternate icon" style="color: #d62f2f;"></i>
      </td>
    </tr>
<% end %>
