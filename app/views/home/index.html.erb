<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Dashboard</title>
  </head>
  <body>
  <br><br>
  <div class="ui centered grid" >
  <div class="computer only row" >
  
  <div class="column" style="text-align: right; margin-right: 50px;"> 
    <a href="/tasks/new" class="ui teal button" style="margin-right: 10px;">
      Add Task
    </a>
    
    <a href="/categories/new" class="ui orange button" style="margin-right: 10px;">
      Add Category
    </a>
    
    <%= link_to tasks_path(format: :xlsx), class: "ui grey button", style: "margin-right: 10px;" do %>
      Today's Task
      <i class="download icon" style="margin-left: 2px;"></i>
    <% end %>
    
  </div>
</div>
  
<div id="loader">
    <div class="spinner"></div>
    <p class="loader-text">Updating Data...</p>
</div>



  <div class="six wide tablet eight wide computer column" style="text-align: center;">
   <%= column_chart @today_tasks_data %>
   <label>Today's Task Progress</label> 
  </div>

  <div class="six wide tablet eight wide computer column" style="text-align: center;">
     <%= pie_chart @today_tasks_priority_data %> 
    <label>Today's Task Priorities</label> 
  </div>
  
  <div class="six wide tablet eight wide computer column" style="text-align: center;">
  <%= column_chart @weekly_tasks_data %>
   <label>Weekly Progress</label> 
  </div>
  <div class="six wide tablet eight wide computer column" style="text-align: center;">
  <%= bar_chart @monthly_tasks_data %>
   <label>Monthly Progress</label> 
   </div>
  <div class="computer only row" style="text-align: center;">
  <%= area_chart @performance_chart_data %>
  <label>Monthly Performance Analysis <strong> (<%= Date.today.beginning_of_month %> - <%= Date.today.end_of_month %>) </strong></label> 
  </div>
</div>

  </body>
</html>



<script>
$(document).ready(function() {
    // Show loader when page starts loading
    // $("#loader").show();

    // Check if the page has already been reloaded
    if (!sessionStorage.getItem('reloaded')) {
        // $("#loader").show();
        sessionStorage.setItem('reloaded', 'true'); // Set flag to prevent infinite reloads
        location.reload();
    } else {
        sessionStorage.removeItem('reloaded'); // Reset for future reloads
        $("#loader").fadeOut("slow"); // Hide loader once reloaded
    }
});

</script>


<style>
#loader {
    position: fixed;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.9);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 9999;
}

.spinner {
    width: 50px;
    height: 50px;
    border: 5px solid #ccc;
    border-top-color: #000;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

.loader-text {
    margin-top: 10px;
    font-size: 14px;
    color: #333;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}



</style>