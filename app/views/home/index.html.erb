<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Dashboard</title>
  </head>
  <body>
  <br><br>
  <div class="ui centered grid" >
  <div class="computer only row" >
    <div class="column" style="text-align: right; margin-right: 50px;"> 
    <button class="ui icon button" style="margin-right: 10px;">
      Today's Task 
      <i class="cloud download icon"></i>
    </button>
    </div>
  </div>

  <div class="six wide tablet eight wide computer column" style="text-align: center;">
   <%= column_chart @today_tasks_data %>
   <label>Todays Task Progress</label> 
  </div>

  <div class="six wide tablet eight wide computer column" style="text-align: center;">
     <%= pie_chart @today_tasks_priority_data %> 
    <label>Todays Task Priorities</label> 
  </div>
  
  <div class="six wide tablet eight wide computer column" style="text-align: center;">
  <%= column_chart @weekly_tasks_data %>
   <label>Weekly Progress</label> 
  </div>
  <div class="six wide tablet eight wide computer column" style="text-align: center;">
  <%= bar_chart @monthly_tasks_data %>
   <label>Monthly Progress</label> 
   </div>
  <div class="computer only row" style="text-align: center;">
  <%= area_chart @performance_chart_data %>
  <label>Monthly Performance Analysis <strong> (<%= Date.today.beginning_of_month %> - <%= Date.today.end_of_month %>) </strong></label> 
  </div>
</div>

  </body>
</html>