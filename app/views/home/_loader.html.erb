

<script>
$(document).ready(function() {
    // Show loader when page starts loading
    // $("#loader").show();

    // Check if the page has already been reloaded
    if (!sessionStorage.getItem('reloaded')) {
        // $("#loader").show();
        sessionStorage.setItem('reloaded', 'true'); // Set flag to prevent infinite reloads
        location.reload();
    } else {
        sessionStorage.removeItem('reloaded'); // Reset for future reloads
        $("#loader").fadeOut("slow"); // Hide loader once reloaded
    }
});

</script>


<style>
#loader {
    position: fixed;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.9);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 9999;
}

.spinner {
    width: 50px;
    height: 50px;
    border: 5px solid #ccc;
    border-top-color: #000;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

.loader-text {
    margin-top: 10px;
    font-size: 14px;
    color: #333;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}



</style>